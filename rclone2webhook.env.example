RCLONE_URL=http://192.168.0.90:5274
RCLONE_AUTH_USER=
RCLONE_AUTH_PASS=

# rclone.conf에 등록된 원격 이름 (콜론 제외)
RCLONE_REMOTE_NAME=union_gds

# 원격 기준 상대 경로 (RCLONE_REMOTE_NAME: 뒤에 붙는 경로)
# TARGET_DIR의 "mnt/gds2/" 같은 마운트 접두어를 뺀 나머지 부분과 동일해야 함
RCLONE_REMOTE_PATH=GDRIVE/READING

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# DB 매칭 및 디스코드 표시용 전체 경로 (기존 형식 유지)
TARGET_DIR=mnt/gds2/GDRIVE/READING

# BookOasis 스캔 웹훅 API
BOOKOASIS_API_URL=http://192.168.0.31:5930/api/webhook/scan
BOOKOASIS_API_TOKEN=1234

# SQLite DB 경로 설정
DB_GENERAL_PATH=/root/docker/BookOasis_stable/db/media_general.db
DB_ADULT_PATH=/root/docker/BookOasis_stable/db/media_adult.db

# 주기 설정 (초 단위)
CHECK_INTERVAL=300    # 5분마다 신규 파일 체크 (원격을 직접 재귀 조회)
REFRESH_INTERVAL=3600 # 1시간마다 Rclone VFS 새로고침 (마운트 사용하는 다른 서비스를 위해 유지)
LIST_TIMEOUT=900      # operations/list 응답 대기 시간(초). tpslimit 등으로 대용량 폴더는 오래 걸릴 수 있음
